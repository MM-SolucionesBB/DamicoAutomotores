# ============================================================
# D'Amico Automotores - Variables de entorno
# Copiá este archivo a `.env` y completá con tus valores reales.
# En Vercel cargá estas mismas variables en: Project > Settings > Environment Variables.
# ============================================================

# --- Supabase (base de datos en la nube, usada por el backend) ---
# URL del proyecto (Project Settings > API > Project URL)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Service Role Key (Project Settings > API > service_role).
# PRECAUCIÓN: tiene permisos totales, solo debe vivir en el backend.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# --- Claves públicas para el cliente (Vite) ---
# Opcional: el frontend no las usa hoy, pero quedan para futuros clientes.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# --- Seguridad ---
# Clave secreta para firmar los JWT de sesión del admin. Cambiala en producción.
JWT_SECRET=tu-secret-super-seguro

# --- Credenciales del administrador ---
# Email y contraseña del admin. Tienen prioridad sobre la tabla `users` de Supabase,
# así que con setear estas dos variables el login del panel ya funciona.
ADMIN_EMAIL=admin@damicoautomotores.com
ADMIN_PASSWORD=tu-contrasena-fuerte

# --- (Opcional) Base de datos local ---
# Si no configurás Supabase, el backend usa `database.json` como respaldo.
# OJO: en Vercel el filesystem es efímero; sin Supabase los cambios del admin no persisten.
